  ],
  "metadata_templates": {
    "source_types": {
      "official": {
        "credibility_multiplier": 1.0,
        "examples": ["official_policy", "perf_review", "company_handbook", "verified_data"]
      },
      "expert": {
        "credibility_multiplier": 0.8,
        "examples": ["manager_feedback", "mentor_notes", "expert_opinion", "technical_lead"]
      },
      "personal": {
        "credibility_multiplier": 0.7,
        "examples": ["self_notes", "resume", "personal_blog", "internal_notes"]
      },
      "community": {
        "credibility_multiplier": 0.5,
        "examples": ["glassdoor", "reddit", "github_issues", "community_forum"]
      },
      "archive": {
        "credibility_multiplier": 0.4,
        "examples": ["old_blog", "cached_page", "wayback_machine", "deprecated_docs"]
      }
    },
    "document_age_scoring": {
      "recent": {
        "days": 90,
        "score": 1.0,
        "label": "< 3 months"
      },
      "current": {
        "days": 180,
        "score": 0.8,
        "label": "3-6 months"
      },
      "stale": {
        "days": 365,
        "score": 0.6,
        "label": "6-12 months"
      },
      "old": {
        "days": 999999,
        "score": 0.4,
        "label": "> 12 months"
      }
    }
  }
