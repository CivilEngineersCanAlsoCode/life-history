          "similarity_score": 0.85,
          "metadata": {
            "source": "internal_notes",
            "date": "2024-03-08",
            "author": "self",
            "category": "career"
          }
        }
      ],
      "expected_conflict": {
        "conflict_type": "NONE",
        "severity": "none",
        "conflict_score": 0.0,
        "reason": "No contradiction - complementary timeline"
      }
    },
    {
      "name": "Date Discrepancy: End Date Conflict",
