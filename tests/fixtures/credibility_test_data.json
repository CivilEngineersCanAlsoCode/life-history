      },
      "expected_credibility": {
        "credibility": 0.32,
        "category": "questionable",
        "recency_score": 1.0,
        "authority_score": 0.7,
        "accuracy_score": 0.2,
        "explanation": "Contradicted by 2+ higher-authority sources (review, metrics)"
      }
    }
  ],
  "scoring_formula": {
    "overall_credibility": "recency × 0.3 + authority × 0.4 + accuracy × 0.3",
    "component_ranges": {
      "recency": {
        "0-1": "Normalized by document age (< 3mo = 1.0, >12mo = 0.4)"
      },
      "authority": {
        "0.3": "Unknown/archive",
        "0.5": "Community/unverified",
        "0.7": "Personal/expert opinion",
        "0.8": "Professional/verified",
        "1.0": "Official/researched"
      },
      "accuracy": {
        "0.2": "Contradicted by other sources",
        "0.3": "Single source, potentially outdated",
        "0.5": "Potentially outdated, some verification",
        "0.7": "Single credible source",
        "0.9": "Corroborated by 2+ sources",
        "1.0": "Verified fact, multiple corroboration"
      }
    }
  }
}
