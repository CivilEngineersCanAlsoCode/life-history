# Life Brain Configuration

# API Keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ChromaDB
CHROMA_PATH=./life_brain_db

# Environment
ENV=development  # development | production

# Logging
LOG_LEVEL=INFO

# Feature Flags
ENABLE_CONFLICT_DETECTION=true
ENABLE_GROUNDEDNESS_CHECK=true
ENABLE_TRANSLATION_LAYER=true
ENABLE_SMALL_TALK_CAPTURE=true
ENABLE_MULTI_EXPERT_PANEL=true

# Thresholds
SEMANTIC_SIMILARITY_THRESHOLD=0.75
CONFLICT_HARD_THRESHOLD=0.6
CONFLICT_SOFT_THRESHOLD=0.3
GROUNDEDNESS_HIGH_THRESHOLD=0.85
GROUNDEDNESS_MEDIUM_THRESHOLD=0.70
GROUNDEDNESS_LOW_THRESHOLD=0.50

# Session Configuration
SESSION_TIMEOUT_HOURS=24
MAX_QUESTIONS_PER_SESSION=15
WEEKLY_REVIEW_INTERVAL_DAYS=7
